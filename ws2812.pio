.program ws2812
.side_set 1

.define public T1 6
.define public T2 7
.define public T3 7

.wrap_target

bitloop:
    out x, 1                 side 0 [T3 - 1]
    jmp !x do_zero          side 1 [T1 - 1]
do_one:
    jmp bitloop             side 1 [T2 - 1]
do_zero:
    nop                     side 0 [T2 - 1]
.wrap